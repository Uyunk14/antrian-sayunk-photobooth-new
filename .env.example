# ==== Salin file ini jadi ".env" lalu isi nilainya ====

# Port server (CloudPanel biasanya pakai reverse proxy ke port ini)
SERVER_PORT=3000

# Lokasi database SQLite (biarkan default kalau tidak yakin)
DATABASE_URL="file:./sayunk.db"

# Kunci rahasia untuk login admin (WAJIB diganti dengan teks acak yang panjang!)
JWT_SECRET="ganti-dengan-teks-acak-panjang-dan-rahasia"

# Akun Super Admin pertama (dibuat otomatis saat server pertama kali jalan)
SUPERADMIN_USERNAME="uyung"
SUPERADMIN_PASSWORD="ganti-password-ini-segera"

# Zona waktu untuk laporan harian (jangan diubah untuk Indonesia bagian barat)
TZ="Asia/Jakarta"

# (Opsional) URL publik web-mu, untuk QR code. Kosongkan untuk deteksi otomatis.
# Contoh: https://antrian.sayunk.com
PUBLIC_URL=""
